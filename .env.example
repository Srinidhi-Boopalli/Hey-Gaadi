# Hey Gaadi — Environment Variables
# Copy this file to .env and fill in your keys
# All services have free tiers

# Groq API (free) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI (free tier) — https://www.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Maps (free tier) — https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeatherMap (free tier) — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Daily.ai (for Pipecat transport — free tier) — https://dashboard.daily.co
DAILY_API_KEY=your_daily_api_key_here

# Model settings (defaults, change if needed)
GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_LANGUAGE=hi   # hi = Hindi, te = Telugu
