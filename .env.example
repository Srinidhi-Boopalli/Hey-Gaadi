# Copy to .env. Process variables override this file. No shell expansion.
# Offline demo works without keys. Enable Whisper for microphone input.
INTENT_BACKEND=rules
INTENT_MIN_SCORE=0.70
ASR_BACKEND=whisper
SLOT_BACKEND=rules
WEATHER_BACKEND=demo
MAPS_BACKEND=links
TTS_BACKEND=browser

# Optional live providers. Select the corresponding backend above.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
